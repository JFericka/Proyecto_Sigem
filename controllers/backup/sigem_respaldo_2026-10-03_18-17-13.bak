-- --------------------------------------------------------
-- Estructura de la tabla `detalle_entradas`
-- --------------------------------------------------------
DROP TABLE IF EXISTS `detalle_entradas`;
CREATE TABLE `detalle_entradas` (
  `id_detalle` int(11) NOT NULL AUTO_INCREMENT,
  `id_entrada` int(11) NOT NULL,
  `id_producto` int(11) NOT NULL,
  `cantidad` int(11) NOT NULL,
  PRIMARY KEY (`id_detalle`),
  KEY `id_entrada` (`id_entrada`),
  KEY `id_producto` (`id_producto`),
  CONSTRAINT `detalle_entradas_ibfk_1` FOREIGN KEY (`id_entrada`) REFERENCES `entradas` (`id_entrada`) ON DELETE CASCADE,
  CONSTRAINT `detalle_entradas_ibfk_2` FOREIGN KEY (`id_producto`) REFERENCES `productos` (`id_producto`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- --------------------------------------------------------
-- Estructura de la tabla `detalle_salidas`
-- --------------------------------------------------------
DROP TABLE IF EXISTS `detalle_salidas`;
CREATE TABLE `detalle_salidas` (
  `id_detalle` int(11) NOT NULL AUTO_INCREMENT,
  `id_salida` int(11) NOT NULL,
  `id_producto` int(11) NOT NULL,
  `cantidad` int(11) NOT NULL,
  `cantidad_devuelta` int(11) NOT NULL DEFAULT 0,
  `estado_item` enum('bueno','dañado','perdido') DEFAULT 'bueno',
  PRIMARY KEY (`id_detalle`),
  KEY `id_salida` (`id_salida`),
  KEY `id_producto` (`id_producto`),
  CONSTRAINT `detalle_salidas_ibfk_1` FOREIGN KEY (`id_salida`) REFERENCES `salidas` (`id_salida`) ON DELETE CASCADE,
  CONSTRAINT `detalle_salidas_ibfk_2` FOREIGN KEY (`id_producto`) REFERENCES `productos` (`id_producto`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- --------------------------------------------------------
-- Estructura de la tabla `entradas`
-- --------------------------------------------------------
DROP TABLE IF EXISTS `entradas`;
CREATE TABLE `entradas` (
  `id_entrada` int(11) NOT NULL AUTO_INCREMENT,
  `numero_voucher` varchar(50) NOT NULL,
  `tipo_entrada` enum('abastecimiento','devolucion') NOT NULL DEFAULT 'abastecimiento',
  `nombre_quien_entrega` varchar(150) NOT NULL,
  `id_salida_origen` int(11) DEFAULT NULL,
  `id_usuario` int(11) NOT NULL,
  `fecha` datetime NOT NULL DEFAULT current_timestamp(),
  `observaciones` text DEFAULT NULL,
  PRIMARY KEY (`id_entrada`),
  UNIQUE KEY `numero_voucher` (`numero_voucher`),
  KEY `id_usuario` (`id_usuario`),
  KEY `fk_salida_origen` (`id_salida_origen`),
  CONSTRAINT `entradas_ibfk_1` FOREIGN KEY (`id_usuario`) REFERENCES `usuarios` (`id_usuario`),
  CONSTRAINT `fk_salida_origen` FOREIGN KEY (`id_salida_origen`) REFERENCES `salidas` (`id_salida`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


-- --------------------------------------------------------
-- Estructura de la tabla `productos`
-- --------------------------------------------------------
DROP TABLE IF EXISTS `productos`;
CREATE TABLE `productos` (
  `id_producto` int(11) NOT NULL AUTO_INCREMENT,
  `codigo_categoria` varchar(50) NOT NULL,
  `codigo` varchar(50) NOT NULL,
  `nombre` varchar(150) NOT NULL,
  `tipo` enum('consumible','herramienta') NOT NULL,
  `unidad` varchar(30) NOT NULL DEFAULT 'unidad',
  `stock_actual` int(11) NOT NULL DEFAULT 0,
  `activo` tinyint(1) NOT NULL DEFAULT 1,
  PRIMARY KEY (`id_producto`),
  UNIQUE KEY `codigo` (`codigo`),
  KEY `codigo_categoria` (`codigo_categoria`),
  CONSTRAINT `productos_ibfk_1` FOREIGN KEY (`codigo_categoria`) REFERENCES `categorias` (`codigo_categoria`)
) ENGINE=InnoDB AUTO_INCREMENT=26 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

